# Paths are relative to the repository root. Keep runtime data outside the source tree.
BEANCOUNT_LEDGER_DIR=../beancount-demo
BEANCOUNT_STATE_DIR=../.beancount-demo-ui

# Git 同步配置：已有副本可省略 REMOTE，使用 origin；克隆时必须指定。
# 凭据使用服务端 Git credential helper 或 SSH agent，禁止带入 URL。
# BEANCOUNT_GIT_REMOTE=https://github.com/silevilence/MyBill.git
BEANCOUNT_GIT_BRANCH=master-1

# 默认仅本机访问；私网模式必须同时设置应用口令及访问 Origin。
BEANCOUNT_ACCESS_MODE=local
# BEANCOUNT_ACCESS_TOKEN_FILE=/run/secrets/beancount_access_token
# 或仅在服务端环境设置 BEANCOUNT_ACCESS_TOKEN（至少 32 字符）
# BEANCOUNT_ALLOWED_ORIGINS=http://ledger.internal:8000
# 可选：前端构建目录，默认 frontend/dist
# BEANCOUNT_FRONTEND_DIR=/app/frontend/dist
